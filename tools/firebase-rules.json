{
  "rules": {
    ".read": false,
    ".write": false,
    "m": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[2-9A-Z]{6}$/) && !data.child('b').child(auth.uid).exists()",
        ".write": "auth != null && $code.matches(/^[2-9A-Z]{6}$/) && !data.child('b').child(auth.uid).exists() && (newData.exists() ? newData.child('o').val() === auth.uid : data.child('o').val() === auth.uid)",
        ".validate": "newData.hasChildren(['o', 'n', 'u', 'on'])",
        "o": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000"
        },
        "u": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "on": {
          ".validate": "newData.isBoolean()"
        },
        "t": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "ev": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 6000"
          }
        },
        "w": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('m').child($code).child('o').exists() && !root.child('m').child($code).child('b').child($uid).exists()",
            ".validate": "newData.hasChildren(['d', 'on'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "d": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "b": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
