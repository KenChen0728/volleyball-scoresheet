{
  "rules": {
    ".read": false,
    ".write": false,
    "m": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[2-9A-Z]{6}$/)",
        ".write": "auth != null && $code.matches(/^[2-9A-Z]{6}$/) && (data.exists() ? data.child('o').val() === auth.uid : newData.child('o').val() === auth.uid)",
        ".validate": "newData.hasChildren(['o', 'n', 'u', 'on'])",
        "o": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000" },
        "u": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "on": { ".validate": "newData.isBoolean()" },
        "ev": {
          "$i": { ".validate": "$i.matches(/^[0-9]{1,4}$/) && newData.isString() && newData.val().length <= 6000" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
